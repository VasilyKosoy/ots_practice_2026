import turtle


def perform_switch_case(state, t, turn):
    x = round(t.position()[0] / 10)
    y = round(t.position()[1] / 10)

    if state == "INIT":
        if True:
            state = "UP"
            t.setheading(90)  # Разворот вверх
            return state, turn

        return state, turn

    if state == "UP":
        t.forward(10)  # Перемещение

        if y >= turn and x < 4:
            state = "RIGHT"
            t.setheading(0)  # Разворот вправо
            return state, turn

        if y >= turn and x >= 4:
            state = "STOP"
            return state, turn

        return state, turn

    if state == "RIGHT":
        t.forward(10)  # Перемещение

        if y <= -turn:
            state = "UP"
            t.setheading(90)  # Разворот вверх
            return state, turn

        if y >= turn:
            state = "DOWN"
            t.setheading(270)  # Разворот вниз
            return state, turn

        return state, turn

    if state == "DOWN":
        t.forward(10)  # Перемещение

        if y <= -turn:
            state = "RIGHT"
            t.setheading(0)  # Разворот вправо
            return state, turn

        return state, turn

    return state, turn


def draw():
    start_state = "INIT"
    end_state = "STOP"
    curr_state = start_state

    t = turtle.Turtle()
    t.speed(0)

    # Опускаем старт ниже, чтобы первый хвостик был длиннее
    t.penup()
    t.goto(0, -20)
    t.pendown()

    turn = 1

    while curr_state != end_state:
        curr_state, turn = perform_switch_case(curr_state, t, turn)

    turtle.done()


if __name__ == "__main__":
    draw()
